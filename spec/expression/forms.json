       }
      ]
     }
    ]
   },
   {
    "name": "OrderForm",
    "title": "Order",
    "entity": "Order",
    "rows": [
     {
      "id": "r1",
      "controls": [
       {
        "id": "o_cust",
        "type": "combo",
        "bind": "customer_id",
        "label": "Customer",
        "source": {
         "entity": "Customer",
         "value": "customerid",
         "display": "name"
        }
       }
      ]
     },
     {
      "id": "r2",
      "controls": [
       {
        "id": "o_status",
        "type": "text",
        "bind": "status",
        "label": "Status",
        "default": "'new'"
       },
       {
        "id": "o_date",
        "type": "date",
        "bind": "order_date",
        "label": "Order date",
        "default": "today()"
       }
      ]
     },
     {
      "id": "r3",
      "controls": [
       {
        "id": "o_ship",
        "type": "date",
        "bind": "ship_date",
        "label": "Ship date",
        "visible": "status == 'shipped'",
        "validate": [
         {
          "expr": "isnull(ship_date) || ship_date >= order_date",
          "message": "Ship date cannot be before the order date"
         }
        ]
       }
      ]
     },
     {
      "id": "r4",
      "controls": [
       {
        "id": "o_notes",
        "type": "text",
        "bind": "notes",
        "label": "Notes",
        "visible": "!isnull(notes) || status == 'open'"
       }
      ]
     },
     {
      "id": "r5",
      "controls": [
       {
        "id": "o_lines",
        "type": "subform",
        "label": "Lines",
        "child": {
         "entity": "OrderLine",
         "link": "order_id",
         "parentKey": "orderid"
        },
        "columns": [
         "product_id",
         "qty",
         "discount"
        ]
       }
      ]
     }
    ]
   },
   {
    "name": "OrderLineForm",
    "title": "Order line",
    "entity": "OrderLine",
    "rows": [
     {
      "id": "r1",
      "controls": [
       {
        "id": "l_prod",
        "type": "combo",
        "bind": "product_id",
        "label": "Product",
        "source": {
         "entity": "Product",
         "value": "productid",
         "display": "name"
        }
       }
      ]
     },
     {
      "id": "r2",
      "controls": [
       {
        "id": "l_qty",
        "type": "number",
        "bind": "qty",
        "label": "Quantity",
        "validate": [
         {
          "expr": "qty > 0",
          "message": "Quantity must be more than zero"
         }
        ]
       },
       {
        "id": "l_disc",
        "type": "number",
        "bind": "discount",
        "label": "Discount",
        "default": "0",
        "validate": [
         {
          "expr": "discount >= 0 && discount <= 1",
          "message": "Discount is between 0 and 1"
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "name": "CreditReviewForm",
    "title": "Credit review",
    "entity": "Customer",
    "rows": [
     {
      "id": "r1",
      "controls": [
       {
        "id": "v_name",
        "type": "text",
