       }
      ]
     },
     {
      "id": "r2",
      "controls": [
       {
        "id": "v_active",
        "type": "checkbox",
        "bind": "active",
        "label": "Active"
       }
      ]
     },
     {
      "id": "r3",
      "controls": [
       {
        "id": "v_credit",
        "type": "number",
        "bind": "credit_limit",
        "label": "Credit limit",
        "visible": "active",
        "validate": [
         {
          "expr": "credit_limit <= 100000",
          "message": "Limit is too high"
         }
        ]
       }
      ]
     },
     {
      "id": "r4",
      "controls": [
       {
        "id": "v_city",
        "type": "text",
        "bind": "city",
        "label": "City",
        "visible": "active && credit_limit > 1000"
       }
      ]
     }
    ]
   }
